#!/bin/sh
# Boot Claude Code in a docker sandbox with this repo mounted.
# Usage: ./sbx [claude args...]   e.g. ./sbx --continue
# First run: log in via the OAuth URL claude prints; auth persists in the
# pricy-sbx-home volume. `docker volume rm pricy-sbx-home` resets it.
set -e
dir="$(cd "$(dirname "$0")" && pwd)"
docker build -q -t pricy-sbx - < "$dir/sbx.Dockerfile"
exec docker run -it --rm \
  -v "$dir":/workspace \
  -v pricy-sbx-home:/home/node \
  ${ANTHROPIC_API_KEY:+-e ANTHROPIC_API_KEY} \
  pricy-sbx claude --dangerously-skip-permissions "$@"
