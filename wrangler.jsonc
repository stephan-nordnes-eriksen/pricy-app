{
  "name": "pricy",
  "compatibility_date": "2026-07-13",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // MCP OAuth surface: discovery, DCR, login page, token exchange must
    // reach the worker — the SPA fallback answering 200+HTML there breaks
    // claude.ai's connector flow. CAUTION: setting run_worker_first AT ALL
    // makes the asset layer claim every path NOT listed (it answered /api/*
    // POSTs with 405, taking down login) — /api/* must stay in this list.
    "run_worker_first": ["/api/*", "/img/*", "/.well-known/*", "/authorize", "/token", "/register", "/mcp"]
  },
  "r2_buckets": [
    {
      // product images, keyed products/<id>, written by ingest's syncImages,
      // served at GET /img/<id>
      "binding": "IMAGES",
      "bucket_name": "pricy-images"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // NOT the account's "pricy" D1 — that one belongs to the other
      // (live pricy.no) project despite the name
      "database_name": "pricy-app",
      "database_id": "ae84c6cb-b7f8-4025-b7a8-7bfb1f9f8dc1"
    }
  ],
  "routes": [
    { "pattern": "pricy.no", "custom_domain": true },
    // www 301s to apex in the fetch handler — keeps the session cookie on one host
    { "pattern": "www.pricy.no", "custom_domain": true }
  ],
  // hourly offer refresh (worker scheduled handler); price_points stay
  // one-per-day via the upsert
  "triggers": { "crons": ["0 * * * *"] },
  // HIDE_AUTOBUY: global auto-buy/buy-now kill switch, must match the
  // prototype's TWEAK_DEFAULTS.hideAutobuy (build.js enforces). Hides the MCP
  // buy tools, 404s /api/buy + PUT /api/autobuy, drops autobuy/purchases
  // from /api/me while the SPA hides every buy surface.
  // VAPID_PUBLIC_KEY: Web Push application server key (base64url P-256 point),
  // served to browsers via GET /api/push/key; the matching private key is the
  // VAPID_PRIVATE_KEY secret (JWK, local copy in tools/.vapid-private.jwk).
  "vars": { "HIDE_AUTOBUY": true, "VAPID_PUBLIC_KEY": "BAW_T9dXDz_esSekgqqImjyXNwQ294OKhskRWBndFSgWYgukRY5CMEtnjJcdqSpkY4PCjm69jZChUPFhS_H7hAo", "CATMAP": {
    "Power": {
      "Mobiltelefon": "Phones",
      "TV": "TV",
      "True wireless hodetelefoner": "Audio",
      "Trådløse hodetelefoner": "Audio",
      "Hodetelefoner med ledning": "Audio",
      "Open-ear hodetelefoner": "Audio",
      "Benledende hodetelefoner": "Audio",
      "Ørepropper": "Audio",
      "Lydplanker": "Audio",
      "Smarthøyttaler": "Audio",
      "Trådløs støvsuger": "Home",
      "Robotstøvsuger": "Home",
      "Smarte lightstrips": "Home",
      "Kaffetrakter": "Kitchen",
      "Airfryers": "Kitchen",
      "Frityrkoker": "Kitchen",
      "Playstation-konsoll": "Gaming",
      "Xbox-konsoll": "Gaming",
      "Nintendo-konsoll": "Gaming",
      "Playstation-kontrollere": "Gaming",
      "Nintendo-kontrollere": "Gaming",
      "Xbox-spill": "Gaming",
      "Nettbrett": "Computers",
      "Lesebrett": "E-readers"
    },
    "CDON": {
      "OLED TV": "TV",
      "Airfryere": "Kitchen",
      "Over-ear hodetelefoner": "Audio",
      "True Wireless med ANC": "Audio",
      "Støvsugere": "Home",
      "Smarte lamper": "Home",
      "Håndkontroller": "Gaming",
      "Lesebrett": "E-readers"
    },
    "NetOnNet": {
      "iPhone": "Phones",
      "Samsung mobiltelefon": "Phones",
      "Xiaomi mobiltelefon": "Phones",
      "Google Pixel": "Phones",
      "Nothing mobiltelefon": "Phones",
      "Motorola mobiltelefon": "Phones",
      "Doro mobiltelefon": "Phones",
      "Mobiltelefoner": "Phones",
      "In-ear-hodetelefoner": "Audio",
      "Over-ear-hodetelefoner": "Audio",
      "Hodetelefoner": "Audio",
      "Trådløse hodetelefoner": "Audio",
      "Hodetelefoner til trening": "Audio",
      "Bluetooth-høyttalere": "Audio",
      "Partyhøyttalere": "Audio",
      "Smarthøyttalere": "Audio",
      "Soundbarer": "Audio",
      "22–45 tommer": "TV",
      "56–70 tommer": "TV",
      "75 tommer og større": "TV",
      "Projektorer": "Projectors",
      // media players/TV sticks are not TVs; Home = smart-home gadgets
      "Mediaspillere": "Home",
      "Google Chromecast": "Home",
      "Nettbrett": "Computers",
      "iPad": "Computers",
      "MacBook": "Computers",
      "Laptoper": "Computers",
      "Laptoper 12 - 14 tommer": "Computers",
      "Laptoper 15 - 16 tommer": "Computers",
      "Chromebooks": "Computers",
      "Gamingskjermer 31–57 tommer": "Computers",
      "Espressomaskiner": "Kitchen",
      "Kaffetraktere": "Kitchen",
      "Kaffemaskiner og kaffe": "Kitchen",
      "Nintendo-konsoller": "Gaming",
      "PlayStation-konsoll": "Gaming",
      "PlayStation": "Gaming",
      "Xbox": "Gaming",
      "Trådløs støvsuger": "Home",
      "Grovstøvsuger": "Home",
      "Selvtømmende robotstøvsugere": "Home",
      "Dampvasker": "Home",
      "Smartlåser": "Home",
      "Philips Hue": "Home",
      "Lego Icons": "Toys",
      "LEGO for voksne 18 år": "Toys",
      "Lesebrett": "E-readers"
    },
    // Vocabulary observed 2026-07-24 from a full sitemap-discovery crawl
    // (worker/sources.js discoverSource()) — a pure toy shop, every category
    // it sent (including the "new arrivals" merchandising label) is Toys
    "Lekeverden": {
      "LEGO": "Toys",
      "Nyankomne": "Toys",
      "LEGO &gt; LEGO Duplo": "Toys",
      "Pedagogiske leker": "Toys",
      "Puslespill": "Toys",
      "Kunstleker": "Toys",
      "Brettspill": "Toys",
      "Squishmallows": "Toys",
      "*": "Toys"
    },
    // The reserved "*" key is a single-category shop's floor: it applies only
    // after the shared vocabulary rules AND the product name both come up
    // empty, so a specialist shop whose pages send SKU codes (Hi-Fi Klubben),
    // a bare "Produkter" (Mestergull) or nothing at all (Bikeshop) still lands
    // its catalog in the right place. Only ever set it where the WHOLE shop
    // genuinely is one category — a general retailer must stay unmapped so the
    // rules decide per product. Measured on a 451-page sample across 47 shops:
    // 45% of rows promoted on rules alone, 93% with these floors.
    //
    // "Is the whole shop one category?" is measurable, and `node
    // tools/score-cats.mjs` measures it: of the shop's rows whose OWN label the
    // vocabulary can read, how many land on the floor's category anyway. Every
    // floor below sits at 61–100% (2026-07-26). Eight shops that sat under 50%
    // on a sample of 60+ readable labels lost theirs — see the note further down.
    // Re-run it before adding a floor, and after any CAT_RULES edit: three of the
    // apparent "general retailers" in the first pass were really the vocabulary
    // misreading an art shop's labels.
    "Bikeshop": { "*": "Bikes" },
    // Gamezone's floor said Gaming until 2026-07-26. It sends no category at all,
    // and its catalog is board games, Warhammer miniatures, dice, RPG books and
    // TCG singles — Gaming (consoles and video games) was wrong for ~580 of its
    // 651 rows, which is what made the Gaming category 92% shop-floor-filed.
    "Gamezone": { "*": "Toys" },
    "Shark Gaming": { "*": "Gaming" },
    "Hi-Fi Klubben": { "*": "Audio" },
    "Mestergull": { "*": "Jewelry" },
    "Bjørklund": { "*": "Jewelry" },
    "David-Andersen": { "*": "Jewelry" },
    "Klokker.no": { "*": "Watches" },
    "Kicks": { "*": "Beauty" },
    "Parfymeri": { "*": "Beauty" },
    "Blivakker": { "*": "Beauty" },
    "Japan Photo": { "*": "Photo" },
    "Bergans": { "*": "Outdoor" },
    // Brand-only labels the shared vocabulary must never read globally (a brand
    // is not a category), pinned per shop where the brand's aisle IS uniform —
    // sampled in the 2026-07-27 product-eval, every row checked:
    // Sølvkroken = fishing tackle, Garmin at Fjellsport = sports watches.
    "Fjellsport": {
      "Sølvkroken": "Outdoor",
      "Varemerker > Sølvkroken": "Outdoor",
      "Garmin": "Watches",
      "Varemerker > Garmin": "Watches",
      "*": "Outdoor"
    },
    "Foss Sport": { "*": "Sport" },
    "Sporttema": { "*": "Sport" },
    "Hobbii": { "*": "Hobby" },
    "Panduro": { "*": "Hobby" },
    "Zooservice": { "*": "Pets" },
    "Nettdyret": { "*": "Pets" },
    "Dyrekassen": { "*": "Pets" },
    "PetXL": { "*": "Pets" },
    "Kidsdreamstore": { "*": "Toys" },
    "Lekia": { "*": "Toys" },
    "Ringo": { "*": "Toys" },
    // Outland/Rusta/Jernia had a floor until 2026-07-26 and are NOT one-category
    // shops: Outland sells manga, books, board games and figures (its floor put
    // 55 Manga rows in Toys), Rusta is a general discount retailer, Jernia sells
    // kitchenware and homeware next to the hardware. Floor-less, so the shared
    // vocabulary decides per product and the rest stays in the hidden backlog —
    // see plans/category-misclassification.md.
    // Outland has no floor, but two labels of its are uniform shelves the
    // vocabulary can't read (checked row by row, 2026-07-27): Merchandise is
    // all figures/keychains/statues, Spill at Proshop is all console games.
    "Outland": { "Merchandise": "Toys" },
    "Proshop": { "Spill": "Gaming" },
    "Guttelus": { "*": "Fashion" },
    "Junior Barneklær": { "*": "Fashion" },
    "KappAhl": { "*": "Fashion" },
    "Skoringen": { "*": "Shoes" },
    "Fagmøbler": { "*": "Furniture" },
    "Møbelringen": { "*": "Furniture" },
    "Chilli": { "*": "Furniture" },
    "Trademax": { "*": "Furniture" },
    "Christiania Belysning": { "*": "Lighting" },
    "Tegne.no": { "*": "Hobby" }
    // Eight shops lost a floor on 2026-07-26, measured with tools/score-cats.mjs:
    // their own readable labels back the floor up less than half the time, because
    // the shop is not one category. Milrab (Outdoor, 10% — its labels say
    // Jakker/Gensere/Løpesko/Sportsklokker), Widforss (Outdoor, 22% — plus a whole
    // dog department), Vitusapotek (Health, 25% — a pharmacy sells skincare and
    // baby formula), Rum21 (Furniture, 38% — 84 rows of lighting), JYSK (Home,
    // 42%), Kid Interiør (Home, 45% — furniture, kitchen, lighting, garden),
    // Sport 1 (12%) and Intersport (15%). Dropping a floor costs no live product:
    // ingest never un-promotes, so their existing rows keep the category they
    // have — only NEW rows whose label says nothing now wait in the hidden
    // backlog (?hidden=1) instead of being filed by shop.
    // Obs and Obs Bygg are deliberately floor-less: general retailers, so the
    // vocabulary rules have to decide per product
  } }
  // Feature flag for real magic-link mail: the worker sends via
  // env.SEND_EMAIL when bound, console.logs the link when not. Email
  // Sending needs the Workers paid plan — once upgraded, onboard pricy.no
  // (dashboard: Email Service → Email Sending → Onboard Domain, adds
  // SPF/DKIM/DMARC), then uncomment and deploy:
  // "send_email": [{ "name": "SEND_EMAIL" }]
}
